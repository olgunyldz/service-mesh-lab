{
  "realm": "partners",
  "displayName": "Partner kurumlar",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "rsa-lab",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": ["200"],
          "enabled": ["true"],
          "active": ["true"],
          "algorithm": ["RS256"],
          "privateKey": ["__IDP_PRIVATE_KEY__"],
          "certificate": ["__IDP_CERTIFICATE__"]
        }
      },
      {
        "name": "hmac-generated-hs512",
        "providerId": "hmac-generated",
        "subComponents": {},
        "config": { "priority": ["100"], "algorithm": ["HS512"] }
      },
      {
        "name": "aes-generated",
        "providerId": "aes-generated",
        "subComponents": {},
        "config": { "priority": ["100"] }
      }
    ]
  },
  "roles": {
    "realm": [
      {
        "name": "partner",
        "description": "Sözleşmeli partner kurum"
      }
    ]
  },
  "groups": [
    { "name": "partner-acme", "attributes": { "partner_id": ["acme"] } },
    { "name": "partner-initech", "attributes": { "partner_id": ["initech"] } }
  ],
  "clients": [
    {
      "clientId": "acme",
      "name": "Acme (partner)",
      "fullScopeAllowed": false,
      "publicClient": false,
      "secret": "__PARTNER_ACME_SECRET__",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "consentRequired": false,
      "attributes": { "client.use.lightweight.access.token.enabled": "true" },
      "protocolMappers": [
        {
          "name": "aud-auth-partner",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "auth-partner", "access.token.claim": "true", "id.token.claim": "false", "lightweight.claim": "true" }
        }
      ]
    },
    {
      "clientId": "initech",
      "name": "Initech (partner)",
      "fullScopeAllowed": false,
      "publicClient": false,
      "secret": "__PARTNER_INITECH_SECRET__",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "consentRequired": false,
      "attributes": { "client.use.lightweight.access.token.enabled": "true" },
      "protocolMappers": [
        {
          "name": "aud-auth-partner",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "auth-partner", "access.token.claim": "true", "id.token.claim": "false", "lightweight.claim": "true" }
        }
      ]
    },
    {
      "clientId": "auth-partner",
      "name": "Token exchange: partner kanalı (DMZ auth-service)",
      "fullScopeAllowed": false,
      "publicClient": false,
      "secret": "__AUTH_PARTNER_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["basic", "acr", "roles"],
      "optionalClientScopes": [],
      "attributes": {
        "standard.token.exchange.enabled": "true",
        "access.token.lifespan": "120"
      },
      "protocolMappers": [
        {
          "name": "aud-internal-apis",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "internal-apis", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "channel",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "channel", "claim.value": "partner", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": { "claim.name": "roles", "multivalued": "true", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "partner_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": { "user.attribute": "partner_id", "claim.name": "partner_id", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "internal-apis",
      "name": "Internal API'ler (yalnızca audience)",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-acme",
      "enabled": true,
      "serviceAccountClientId": "acme",
      "realmRoles": ["partner"],
      "groups": ["/partner-acme"]
    },
    {
      "username": "service-account-initech",
      "enabled": true,
      "serviceAccountClientId": "initech",
      "realmRoles": ["partner"],
      "groups": ["/partner-initech"]
    }
  ],
  "scopeMappings": [
    { "client": "acme", "roles": ["partner"] },
    { "client": "initech", "roles": ["partner"] },
    { "client": "auth-partner", "roles": ["partner"] }
  ]
}
