{
  "realm": "customers",
  "displayName": "Müşteriler (web, mobil)",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and notUsername",
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "rsa-lab",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": ["200"],
          "enabled": ["true"],
          "active": ["true"],
          "algorithm": ["RS256"],
          "privateKey": ["__IDP_PRIVATE_KEY__"],
          "certificate": ["__IDP_CERTIFICATE__"]
        }
      },
      {
        "name": "hmac-generated-hs512",
        "providerId": "hmac-generated",
        "subComponents": {},
        "config": { "priority": ["100"], "algorithm": ["HS512"] }
      },
      {
        "name": "aes-generated",
        "providerId": "aes-generated",
        "subComponents": {},
        "config": { "priority": ["100"] }
      }
    ]
  },
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Bankanın müşterisi"
      }
    ]
  },
  "clients": [
    {
      "clientId": "web-app",
      "name": "Web (token handler, DMZ)",
      "description": "Gizli client: OIDC akışını web-token-handler sunucu tarafında yürütür; tarayıcı token görmez",
      "fullScopeAllowed": false,
      "publicClient": false,
      "secret": "__WEB_APP_SECRET__",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "consentRequired": false,
      "redirectUris": [
        "https://www.apps.example.local:8443/auth/callback",
        "https://www.apps.example.local/auth/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://www.apps.example.local:8443/##https://www.apps.example.local/",
        "client.use.lightweight.access.token.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "aud-auth-web",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "auth-web", "access.token.claim": "true", "id.token.claim": "false", "lightweight.claim": "true" }
        }
      ]
    },
    {
      "clientId": "mobile-app",
      "name": "Mobil uygulama",
      "fullScopeAllowed": false,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": __LAB_DIRECT_GRANT__,
      "consentRequired": false,
      "redirectUris": [
        "tr.com.example.bank:/oauth2redirect"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "client.use.lightweight.access.token.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "aud-auth-mobile",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "auth-mobile", "access.token.claim": "true", "id.token.claim": "false", "lightweight.claim": "true" }
        }
      ]
    },
    {
      "clientId": "auth-web",
      "name": "Token exchange: web kanalı (DMZ auth-service)",
      "fullScopeAllowed": false,
      "publicClient": false,
      "secret": "__AUTH_WEB_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["basic", "acr", "roles"],
      "optionalClientScopes": [],
      "attributes": {
        "standard.token.exchange.enabled": "true",
        "access.token.lifespan": "120"
      },
      "protocolMappers": [
        {
          "name": "aud-internal-apis",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "internal-apis", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "channel",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "channel", "claim.value": "web", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": { "claim.name": "roles", "multivalued": "true", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "auth-mobile",
      "name": "Token exchange: mobil kanal (DMZ auth-service)",
      "fullScopeAllowed": false,
      "publicClient": false,
      "secret": "__AUTH_MOBILE_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["basic", "acr", "roles"],
      "optionalClientScopes": [],
      "attributes": {
        "standard.token.exchange.enabled": "true",
        "access.token.lifespan": "120"
      },
      "protocolMappers": [
        {
          "name": "aud-internal-apis",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "internal-apis", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "channel",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "channel", "claim.value": "mobile", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": { "claim.name": "roles", "multivalued": "true", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "internal-apis",
      "name": "Internal API'ler (yalnızca audience)",
      "description": "Kimse bununla giriş yapmaz; iç JWT'nin aud değeri. Internal yalnızca aud=internal-apis kabul eder",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "ayse",
      "enabled": true,
      "email": "ayse@example.com",
      "emailVerified": true,
      "firstName": "Ayşe",
      "lastName": "Yılmaz",
      "credentials": [
        {
          "type": "password",
          "value": "__CUSTOMER_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ]
    }
  ],
  "scopeMappings": [
    { "client": "web-app", "roles": ["customer"] },
    { "client": "mobile-app", "roles": ["customer"] },
    { "client": "auth-web", "roles": ["customer"] },
    { "client": "auth-mobile", "roles": ["customer"] }
  ]
}
