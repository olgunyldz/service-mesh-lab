{
  "realm": "staff",
  "displayName": "Şube personeli",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "bruteForceProtected": true,
  "failureFactor": 3,
  "maxFailureWaitSeconds": 1800,
  "passwordPolicy": "length(14) and notUsername and passwordHistory(5)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "rsa-lab",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": [
            "200"
          ],
          "enabled": [
            "true"
          ],
          "active": [
            "true"
          ],
          "algorithm": [
            "RS256"
          ],
          "privateKey": [
            "__IDP_PRIVATE_KEY__"
          ],
          "certificate": [
            "__IDP_CERTIFICATE__"
          ]
        }
      },
      {
        "name": "hmac-generated-hs512",
        "providerId": "hmac-generated",
        "subComponents": {},
        "config": {
          "priority": [
            "100"
          ],
          "algorithm": [
            "HS512"
          ]
        }
      },
      {
        "name": "aes-generated",
        "providerId": "aes-generated",
        "subComponents": {},
        "config": {
          "priority": [
            "100"
          ]
        }
      }
    ]
  },
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "teller",
        "description": "Gişe"
      },
      {
        "name": "operations",
        "description": "Operasyon"
      },
      {
        "name": "supervisor",
        "description": "Şube yetkilisi: limit üstü işlemlerde dört göz onayı (09e)"
      }
    ]
  },
  "groups": [
    {
      "name": "sube-0001",
      "attributes": {
        "branch_id": [
          "sube-0001"
        ]
      }
    },
    {
      "name": "sube-0002",
      "attributes": {
        "branch_id": [
          "sube-0002"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "branch-teller",
      "name": "Şube gişe uygulaması",
      "fullScopeAllowed": false,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": __LAB_DIRECT_GRANT__,
      "consentRequired": false,
      "redirectUris": [
        "https://branch-api.corp.internal/*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "client.use.lightweight.access.token.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "aud-auth-branch",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "auth-branch",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "lightweight.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "acr",
        "roles",
        "info:read",
        "accounts:read",
        "transfers:write"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "auth-branch",
      "name": "Token exchange: şube kanalı (DMZ auth-service)",
      "fullScopeAllowed": false,
      "publicClient": false,
      "secret": "__AUTH_BRANCH_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "basic",
        "roles"
      ],
      "optionalClientScopes": [
        "info:read",
        "accounts:read",
        "transfers:write"
      ],
      "attributes": {
        "standard.token.exchange.enabled": "true",
        "access.token.lifespan": "120"
      },
      "protocolMappers": [
        {
          "name": "aud-internal-apis",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "internal-apis",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "channel",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "channel",
            "claim.value": "branch",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "branch_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "branch_id",
            "claim.name": "branch_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "internal-apis",
      "name": "Internal API'ler (yalnızca audience)",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "teller01",
      "enabled": true,
      "firstName": "Gişe",
      "lastName": "Personeli",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "__STAFF_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "teller"
      ],
      "groups": [
        "/sube-0001"
      ]
    },
    {
      "username": "yetkili01",
      "enabled": true,
      "firstName": "Şube 1",
      "lastName": "Yetkilisi",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "__STAFF_SUP1_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "supervisor"
      ],
      "groups": [
        "/sube-0001"
      ]
    },
    {
      "username": "yetkili02",
      "enabled": true,
      "firstName": "Şube 2",
      "lastName": "Yetkilisi",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "__STAFF_SUP2_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "supervisor"
      ],
      "groups": [
        "/sube-0002"
      ]
    }
  ],
  "scopeMappings": [
    {
      "client": "branch-teller",
      "roles": [
        "teller",
        "operations",
        "supervisor"
      ]
    },
    {
      "client": "auth-branch",
      "roles": [
        "teller",
        "operations",
        "supervisor"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "description": "sub (her token'da)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "acr",
      "description": "Doğrulama seviyesi (acr)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "acr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "Realm rolleri (realm_access.roles)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "info:read",
      "description": "Genel bilgi uçları (api-a)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "accounts:read",
      "description": "Hesap okuma",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "transfers:write",
      "description": "Para transferi",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "defaultDefaultClientScopes": [
    "basic",
    "acr",
    "roles"
  ],
  "defaultOptionalClientScopes": []
}
