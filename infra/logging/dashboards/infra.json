{
  "uid": "logs-infra",
  "title": "Infra - Platform uyarı ve hataları",
  "description": "Platform bileşenlerinin yalnızca uyarı ve hata satırları (10 · logging: infra süzmesi).",
  "tags": [
    "loki",
    "10-logging"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Namespace'e göre uyarı / hata",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (count_over_time({category=\"infra\"} [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{namespace}}",
          "datasource": {
            "type": "loki",
            "uid": "logs-infra"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "datasource": {
        "type": "loki",
        "uid": "logs-infra"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "bargauge",
      "title": "En gürültülü container'lar",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (namespace, container) (count_over_time({category=\"infra\"} [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{namespace}}/{{container}}",
          "datasource": {
            "type": "loki",
            "uid": "logs-infra"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "logs-infra"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Cluster'a göre",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster) (count_over_time({category=\"infra\"} [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{cluster}}",
          "datasource": {
            "type": "loki",
            "uid": "logs-infra"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "logs-infra"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "Uyarı ve hatalar",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "{category=\"infra\"}",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "logs-infra"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "id": 4,
      "datasource": {
        "type": "loki",
        "uid": "logs-infra"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 14
      }
    }
  ]
}
