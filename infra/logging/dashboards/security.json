    {
      "type": "logs",
      "title": "Güvenlik olayları (WAF, ret, giriş hatası, dört göz)",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "{category=\"security\", namespace!=\"kube-audit\"} |~ \"ModSecurity: Access denied|RED channel=|LOGIN_ERROR|DÖRT GÖZ|MESAİ DIŞI\"",
          "queryType": "range",
          "datasource": {
