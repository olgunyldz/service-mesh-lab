    {
      "type": "timeseries",
      "title": "auth-service redleri (sebep)",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (sebep) (count_over_time({namespace=\"auth\"} |= \"RED channel=\" | regexp `sebep=\"(?P<sebep>[^\"]*)\"` [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{sebep}}",
          "datasource": {
            "type": "loki",
            "uid": "logs-security"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
