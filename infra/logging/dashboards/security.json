    {
      "type": "bargauge",
      "title": "Audit: işlem ve kaynak",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (verb, objectRef_resource) (count_over_time({namespace=\"kube-audit\"} | json [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{verb}} {{objectRef_resource}}",
          "datasource": {
            "type": "loki",
            "uid": "logs-security"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
