          "refId": "A",
          "expr": "{namespace=\"kube-audit\"} | json | objectRef_resource=\"secrets\"",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "logs-security"
          }
        }
      ],
      "options": {
        "showTime": true,
