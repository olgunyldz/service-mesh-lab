{
  "uid": "logs-security",
  "title": "Security - Güvenlik olayları",
  "description": "WAF engellemeleri, Kubernetes audit, auth-service redleri, Keycloak giriş olayları, dört göz ihlali ve personel erişimi (uygulama loglarından kopya).",
  "tags": [
    "loki",
    "10-logging"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "WAF engellemesi",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({cluster=\"edge\"} |= \"ModSecurity: Access denied\" [$__range]))",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "logs-security"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 1,
      "datasource": {
        "type": "loki",
        "uid": "logs-security"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
