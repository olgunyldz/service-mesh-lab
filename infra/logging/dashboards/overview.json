{
  "uid": "logs-overview",
  "title": "Loglar - Genel bakış",
  "description": "Tüm zone'ların logları (Loki, beş kategori). request_id ile bir isteğin izini sürmek için yukarıdaki kutuya kimliği yazın. Başarılı (2xx/3xx) access log'lar request_id'ye göre 1/10 örneklenir; hata, ret ve bayraklı istekler tam.",
  "tags": [
    "loki",
    "10-logging"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "request_id",
        "label": "request_id",
        "description": "Bir isteğin kimliği (ör. api-a'nın gördüğü X-Request-Id)",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
