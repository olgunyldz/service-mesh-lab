    {
      "type": "logs",
      "title": "request_id ile iz (tüm kategoriler, tüm zone'lar)",
      "description": "Yukarıdaki request_id kutusu boşsa tüm loglar gelir. Aynı kimlik DMZ ve internal access log'larında ve auth-service logunda görünür",
      "targets": [
        {
          "refId": "A",
          "expr": "{category=~\".+\"} |= \"$request_id\"",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "logs-all"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "id": 17,
      "datasource": {
        "type": "loki",
        "uid": "logs-all"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 12
      }
    },
    {
      "type": "logs",
      "title": "Son hatalar (5xx ve Envoy bayrakları)",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "{category=\"network\", container=\"istio-proxy\"} | json | response_code >= 500 or response_flags != \"-\"",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "logs-all"
          }
        }
      ],
      "options": {
