    {
      "type": "stat",
      "title": "apps",
      "description": "Seçili aralıkta apps kategorisindeki satır sayısı",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({category=\"apps\"} [$__range]))",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "logs-all"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
