{
  "uid": "logs-apps",
  "title": "Apps - Uygulama logları",
  "description": "BFF'ler, account-api, auth-service, web token handler, device-registry, api-a.",
  "tags": [
    "loki",
    "10-logging"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Servise göre log hacmi",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (count_over_time({category=\"apps\"} [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{namespace}}",
          "datasource": {
            "type": "loki",
            "uid": "logs-apps"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "datasource": {
        "type": "loki",
        "uid": "logs-apps"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Hata satırları",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (count_over_time({category=\"apps\"} |~ \"(?i)error|panic|fail\" [$__auto]))",
