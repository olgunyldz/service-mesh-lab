Size=28;rounded=1;arcSize=4;container=1;collapsible=0;fillColor=#e5f4e5;swimlaneFillColor=#ffffff;strokeColor=#6abd6a;strokeWidth=1.5;dashed=1;dashPattern=4 3;swimlaneLine=0;align=left;spacingLeft=12;fontSize=14;fontStyle=1;fontColor=#1f5f1f;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="455.0" y="150.0" width="422.0" height="200.0" as="geometry"/></mxCell><mxCell id="v66" value="ns tracing" style="swimlane;html=1;startSize=28;rounded=1;arcSize=4;container=1;collapsible=0;fillColor=#e5f4e5;swimlaneFillColor=#ffffff;strokeColor=#6abd6a;strokeWidth=1.5;dashed=1;dashPattern=4 3;swimlaneLine=0;align=left;spacingLeft=12;fontSize=14;fontStyle=1;fontColor=#1f5f1f;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="894.0" y="150.0" width="422.0" height="160.0" as="geometry"/></mxCell><mxCell id="v76" value="ns siem-forwarder" style="swimlane;html=1;startSize=28;rounded=1;arcSize=4;container=1;collapsible=0;fillColor=#e5f4e5;swimlaneFillColor=#ffffff;strokeColor=#6abd6a;strokeWidth=1.5;dashed=1;dashPattern=4 3;swimlaneLine=0;align=left;spacingLeft=12;fontSize=14;fontStyle=1;fontColor=#1f5f1f;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="16.0" y="364.0" width="422.0" height="120.0" as="geometry"/></mxCell><mxCell id="v83" value="ns vault" style="swimlane;html=1;startSize=28;rounded=1;arcSize=4;container=1;collapsible=0;fillColor=#e5f4e5;swimlaneFillColor=#ffffff;strokeColor=#6abd6a;strokeWidth=1.5;dashed=1;dashPattern=4 3;swimlaneLine=0;align=left;spacingLeft=12;fontSize=14;fontStyle=1;fontColor=#1f5f1f;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="455.0" y="364.0" width="422.0" height="120.0" as="geometry"/></mxCell><mxCell id="v89" value="ns platform" style="swimlane;html=1;startSize=28;rounded=1;arcSize=4;container=1;collapsible=0;fillColor=#e5f4e5;swimlaneFillColor=#ffffff;strokeColor=#6abd6a;strokeWidth=1.5;dashed=1;dashPattern=4 3;swimlaneLine=0;align=left;spacingLeft=12;fontSize=14;fontStyle=1;fontColor=#1f5f1f;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="894.0" y="324.0" width="422.0" height="160.0" as="geometry"/></mxCell><mxCell id="v99" value='&lt;span style="font-size:13.5px;color:#1f1f1f;font-weight:bold;"&gt;Gözlem hattı: kaynak → giriş → depo → arayüz&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12.5px;color:#2b2b2b;"&gt;Log:   fluent-bit (her node) → egress → mgmt-ingressgw → log-kafka → logstash (ayrıştırma, maskeleme) → elasticsearch → kibana · siem-forwarder&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12.5px;color:#2b2b2b;"&gt;Metrik: prometheus-agent (her cluster) → remote_write → mgmt-ingressgw → thanos-receive → thanos-query → grafana · alertmanager&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12.5px;color:#2b2b2b;"&gt;İz:    Envoy (gateway, waypoint) → OTLP → mgmt-ingressgw → otel-collector (örnekleme) → tempo → grafana (log ↔ iz geçişi)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12.5px;color:#2b2b2b;"&gt;Güvenlik: k8s audit · WAF · IdP olayları → SIEM (korelasyon, SOAR) · arşiv: worm-archive (Object Lock)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12.5px;color:#2b2b2b;"&gt;Pilot karşılığı: Loki + Fluent Bit, Prometheus, Tempo (bkz. docs/pilot-architecture.md)&lt;/span&gt;' style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#fffdf3;strokeColor=#d8cfa3;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="16.0" y="544.0" width="1300.0" height="126.5" as="geometry"/></mxCell><mxCell id="v100" value="↦ out → cluster API :6443 (Argo CD) · sertifika (Vault PKI → istio-csr)" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#c2410c;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11.5;fontStyle=1;fontColor=#c2410c;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="810.1" y="791.0" width="505.9" height="19.0" as="geometry"/></mxCell><mxCell id="v101" value="⇥ in ← bastion / PAM (MFA, oturu