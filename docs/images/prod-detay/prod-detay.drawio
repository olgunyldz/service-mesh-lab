lor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v28"><mxGeometry x="242.0" y="17.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v56" value="4" style="ellipse;html=1;fillColor=#2f7bd8;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v28"><mxGeometry x="487.0" y="77.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v57" value="5" style="ellipse;html=1;fillColor=#c2410c;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v28"><mxGeometry x="467.0" y="230.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v7" value="Deployment ×3 · SA mobile-gw" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="778.9" y="7.5" width="183.1" height="15.5" as="geometry"/></mxCell><mxCell id="v8" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;istio-proxy (Envoy) · gateway modu: Envoy pod'un kendisi (sidecar değil)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;listener :443 · TLS (m-api sertifikası) · istemci sertifikası yalnızca Edge-DMZ CA (F5)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;filtre 1 · header temizliği: dışarıdan gelen x-channel / x-user-jwt / x-forwarded-* silinir; x-channel=mobile&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;filtre 2 · local rate limit (30 rps) · CORS · istek boyutu sınırı&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;filtre 3 · ext_authz → auth-proxy.auth:8080 (DPoP, attestation, introspection, exchange); ret: 401 / 403 / 426&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;filtre 4 · global kota → ratelimit.ratelimit:8081 (gRPC)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;route · /mobile/v1/* → önek kaldırılır → dmz-egressgw:443 (Host: mobile-bff.internal) · iç JWT eklenir&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;erişim logu (JSON: request_id, channel, trace_id) → stdout · iz → OTLP (%10)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;yönetim: :15021 sağlık · :15090 metrik (Prometheus) · :15000 admin (yalnızca pod içi)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff1e0;strokeColor=#e39b62;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="8.0" y="28.0" width="954.0" height="158.0" as="geometry"/></mxCell><mxCell id="v9" value='&lt;span style="font-size:12.5px;color:#1f1f1f;font-weight:bold;"&gt;pilot-agent&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;xDS → istiod :15012 (mTLS) · sertifika yenileme (SPIFFE, 24 saat)&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f5e8;strokeColor=#6abd6a;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="8.0" y="191.0" width="954.0" height="39.0" as="geometry"/></mxCell><mxCell id="v31" value="Deployment ×2" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v30"><mxGeometry x="373.8" y="7.5" width="88.2" height="15.5" as="geometry"/></mxCell><mxCell id="v32" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;istio-proxy (Envoy) · L7&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;in :15008 HBONE (yalnızca mesh kimlikleri)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;AuthZ: kaynak = gateway'ler, token handler&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;zaman aşımı · yeniden deneme · erişim logu&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;iz span'i (OTLP)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff1e0;strokeColor=#e39b62;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v30"><mxGeometry x="8.0" y="28.0" width="454.0" height="90.0" as="geometry"/></mxCell><mxCell id="v34" value="Deployment ×3 · SA auth-proxy" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v33"><mxGeometry x="282.6" y="7.5" width="189.4" height="15.5" as="geometry"/></mxCell><mxCell id="v35" value='&lt;span style="font-size:12.5px;color:#1f1f1f;font-weight:bold;"&gt;auth-proxy (Go, distroless, non-root)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;:8080 HTTP ext_authz kontrol ucu&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;salt okunur kök dosya sistemi · yetenek yok&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;token önbelleği (30 sn) · tekil istek birleştirme&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eaf2fd;strokeColor=#6d9fe4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v33"><mxGeometry x="8.0" y="28.0" width="464.0" height="73.0" as="geometry"/></mxCell><mxCell id="v36" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;secret (Vault → External Secrets)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;colo