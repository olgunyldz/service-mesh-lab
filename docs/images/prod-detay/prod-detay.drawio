eColor=#a3a3a3;strokeWidth=3;dashed=1;dashPattern=4 2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=-13;fontSize=13.5;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#a3a3a3;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="14.0" y="276.0" width="2172.0" height="854.0" as="geometry"/></mxCell><mxCell id="v47" value="↦ out → DMZ: 02 · 03" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#c2410c;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11.5;fontStyle=1;fontColor=#c2410c;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="430.0" y="1133.0" width="154.0" height="19.0" as="geometry"/></mxCell><mxCell id="v74" value="&lt;span style=&quot;font-size:13.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;Bu resimde&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;İnternet kanalları dört katmandan geçer: DDoS → GSLB → NGFW → F5 (WAF). Her katman kendi kontrolünü yapar.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Şube ve ATM / POS internet edge'ini hiç kullanmaz: kurum WAN'ı ve kendi firewall'ları.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Kart verisi (PAN) yalnızca PCI cluster'ında; internal'a token gider (06).&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;DMZ'nin içi: 02 (cluster) ve 03 (pod); şube gw → internal: 04.&lt;/span&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#fffdf3;strokeColor=#d8cfa3;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="1170.0" width="700.0" height="108.0" as="geometry"/></mxCell><mxCell id="v75" value="Lejant" style="rounded=1;arcSize=3;html=1;container=1;collapsible=0;fillColor=#fafaf8;strokeColor=#c4c4bf;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;f