as="geometry"/></mxCell><mxCell id="v34" value="2" style="ellipse;html=1;fillColor=#2f7bd8;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="577.0" y="77.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v35" value="3" style="ellipse;html=1;fillColor=#c2410c;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="571.0" y="305.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v36" value="4" style="ellipse;html=1;fillColor=#c2410c;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="571.0" y="331.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v37" value="5" style="ellipse;html=1;fillColor=#c2410c;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="571.0" y="383.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v8" value="Deployment ×2 · L7" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v7"><mxGeometry x="432.1" y="7.5" width="119.9" height="15.5" as="geometry"/></mxCell><mxCell id="v9" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;istio-proxy (Envoy)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;in :15008 HBONE · yalnızca mesh kimlikleri&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;RequestAuthentication: iç JWT (iss = Keycloak realm, aud internal-apis)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;AuthZ: kaynak = channel-bff SA'ları · scope transfers:write · acr ≥ 2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;VirtualService: zaman aşımı · yalnızca GET'te yeniden deneme&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;DestinationRule: bağlantı havuzu · outlier detection&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;erişim logu · iz span'i · metrik (:15090)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff1e0;strokeColor=#e39b62;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v7"><mxGeometry x="8.0" y="28.0" width="544.0" height="124.0" as="geometry"/></mxCell><mxCell id="v11" value="Deployment ×3 · HPA · PDB · SA transfer" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v10"><mxGeometry x="539.3" y="7.5" width="252.7" height="15.5" as="geometry"/></mxCell><mxCell id="v12" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;transfer (Java 21 / Go, distroless, non-root, salt okunur kök FS)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;:8080 HTTP · /actuator/health (liveness / readiness) · :9464 metrik&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;Idempotency-Key kontrolü · saga adımı · outbox tablosuna olay (aynı transaction)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;iç JWT'den: sub (müşteri) · acr · scope · sid → yetki ve denetim kaydı&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eaf2fd;strokeColor=#6d9fe4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v10"><mxGeometry x="8.0" y="28.0" width="784.0" height="73.0" as="geom