;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="597.0" y="1061.5" width="298.5" height="16.9" as="geometry"/></mxCell><mxCell id="v88" value="DMZ → veri zone (PostgreSQL, Kafka, core): yol yok" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12.5;fontColor=#b91c1c;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1512.0" y="1061.5" width="381.0" height="16.9" as="geometry"/></mxCell><mxCell id="v90" value="Lejant" style="rounded=1;arcSize=3;html=1;container=1;collapsible=0;fillColor=#fafaf8;strokeColor=#c4c4bf;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="1096.0" width="2140.0" height="128.0" as="geometry"/></mxCell><mxCell id="v122" value="02 · DMZ cluster'ı (ocp-dmz): node havuzları, namespace'ler, pod'lar" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=25;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="21.0" width="1026.0" height="33.8" as="geometry"/></mxCell><mxCell id="v123" value="her pod: ad · iş yükü türü · replika · container'lar · ne yaptığı · yeşil = giriş, turuncu = çıkış" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="62.0" width="868.4" height="21.6" as="geometry"/></mxCell><mxCell id="v3" value="⇥ in ← F5 :443 (Edge-DMZ CA mTLS): ib · stream · auth · m-api · api" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#1d7a46;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11.5;fontStyle=1;fontColor=#1d7a46;fontFamily=Segoe UI;" vertex="1" parent="v2"><mxGeometry x="20.0" y="19.0" width="478.3" height="19.0" as="geometry"/></mxCell><mxCell id="v4" value="↦ out → internal int-ingressgw :443 (04) · kimlik zone :443 (07) · mgmt: log / metrik / iz (07)" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#c2410c;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11.5;fontStyle=1;fontColor=#c2410c;fontFamily=Segoe UI;" vertex="1" parent="v2"><mxGeometry x="1468.5" y="19.0" width="671.5" height="19.0" as="geometry"/></mxCell><mxCell id="v5" value="&lt;span style=&quot;font-size:19px;color:#8a3d0b;&quot;&gt;Infra node havuzu (taint: infra) · gateway'ler · ayrı node'lar&lt;/span&gt;" style="rounded=1;arcSize=3;html=1;container=1;collapsible=0;dropTarget=0;whiteSpace=wrap;fillColor=#ffe8d4;strokeColor=#ec9656;strokeWidth=1.8;dashed=1;dashPattern=4 3;verticalAlign=top;align=left;spacingLeft=24;spacingTop=12;spacingRight=12;fontFamily=Segoe UI;" vertex="1" parent="v2"><mxGeometry x="20.0" y="60.0" width="1060.0" height="640.0" as="geometry"/></mxCell><mxCell id="v38" value="&lt;span style=&quot;font-size:19px;color:#8a3d0b;&quot;&gt;Worker node havuzu · uygulama pod'ları · her namespace'te waypoint (L7)&lt;/span&gt;" style="rounded=1;arcSize=3;html=1;container=1;collapsible=0;dropTarget=0;whiteSpace=wrap;fillColor=#ffe8d4;strokeColor=#ec9656;strokeWidth=1.8;dashed=1;dashPattern=4 3;verticalAlign=top;align=left;spacingLeft=24;spacingTop=12;spacingRight=12;fontFamily=Segoe UI;" vertex="1" parent="v2"><mxGeometry x="1100.0" y="60.0" width="1060.0" height="640.0" as="geometry"/></mxCell><mxCell id="v86" value="ext_authz: her kanal, her istek → auth-proxy (iç JWT gateway'e döner)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12.5;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v2"><mxGeometry x="1380.0" y="729.5" width="523.5" height="16.9" as="geometry"/></mxCell><mxCell id="v89" value="&lt;span style=&quot;font-size:13.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;Bu resimde&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Gateway'ler ayrı node'larda (infra): internetten gelen trafiği karşılayan pod'lar uygulama pod'larıyla aynı node'u paylaşmaz.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Uygulama namespace'leri ambient: pod'larda sidecar yok; mTLS node'daki ztunnel'de, L7 kurallar namespace'in waypoint'inde.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Kanallar (ib → token handler, m-api, api) isteği iç JWT ile dmz-egressgw'ye verir: internal'a tek kapı. Dış token DMZ'de kalır.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;DMZ'den veri ve core zone'una yol yok.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Pod'un içi (container, port, filtre zinciri, agent'lar): 03.&lt;/span&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#fffdf3;strokeColor=#d8cfa3;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="v2"><mxGeometry x="20.0" y="760.0" width="1100.0" height="126.5" as="geometry"/></mxCell><mxCell id="v91" value="" style="html=1;rounded=1;fillColor=#ffe8d4;strokeColor=#ec9656;strokeWidth=1.5;fontFamily=Segoe UI;" vertex="1" parent="v90"><mxGeometry x="14.0" y="34.0" width="30.0" height="17.0" as="geometry"/></mxCell><mxCell id="v92" value="DMZ" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#1f1f1f;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v90"><mxGeometry x="54.0" y="34.0" width="27.5" height="17.6" as="geometry"/></mxCell><mxCell id="v93" value="" style="html=1;rounded=1;fillColor=#e5f4e5;strokeColor=#6abd6a;strokeWidth=1.5;fontFamily=Segoe UI;" vertex="1" parent="v90"><mxGeometry x="366.0" y="34.0" width="30.0" height="17.0" as="geometry"/></mxCell><mxCell id="v94" value="platform / gözlem" style="text;html=1;whiteSpace=nowrap;align=left;vertical