"v3"><mxGeometry x="20.0" y="371.0" width="426.0" height="18.9" as="geometry"/></mxCell><mxCell id="v13" value="⬡ ztunnel" style="swimlane;html=1;startSize=26;rounded=1;arcSize=6;container=1;collapsible=0;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#6abd6a;strokeWidth=1.8;dashed=1;dashPattern=4 3;swimlaneLine=0;align=left;spacingLeft=8;fontSize=13.5;fontStyle=1;fontColor=#1f1f1f;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="20.0" y="399.0" width="244.0" height="129.0" as="geometry"/></mxCell><mxCell id="v16" value="⬡ istio-cni" style="swimlane;html=1;startSize=26;rounded=1;arcSize=6;container=1;collapsible=0;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#6abd6a;strokeWidth=1.8;dashed=1;dashPattern=4 3;swimlaneLine=0;align=left;spacingLeft=8;fontSize=13.5;fontStyle=1;fontColor=#1f1f1f;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="274.0" y="399.0" width="244.0" height="129.0" as="geometry"/></mxCell><mxCell id="v19" value="⬡ fluent-bit" style="swimlane;html=1;startSize=26;rounded=1;arcSize=6;container=1;collapsible=0;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#6abd6a;strokeWidth=1.8;dashed=1;dashPattern=4 3;swimlaneLine=0;align=left;spacingLeft=8;fontSize=13.5;fontStyle=1;fontColor=#1f1f1f;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="528.0" y="399.0" width="244.0" height="129.0" as="geometry"/></mxCell><mxCell id="v22" value="⬡ node-exporter" style="swimlane;html=1;startSize=26;rounded=1;arcSize=6;container=1;collapsible=0;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#6abd6a;strokeWidth=1.8;dashed=1;dashPattern=4 3;swimlaneLine=0;align=left;spacingLeft=8;fontSize=13.5;fontStyle=1;fontColor=#1f1f1f;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="782.0" y="399.0" width="244.0" height="112.0" as="geometry"/></mxCell><mxCell id="v25" value="&lt;span style=&quot;font-size:13.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;Gateway pod'u neden farklı?&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Gateway Envoy'un kendisidir: trafiği karşılayan, TLS'i sonlandıran ve kuralları uygulayan container bu.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Uygulama pod'larında Envoy yok (ambient): mTLS'i node'daki ztunnel, L7 kurallarını namespace'in waypoint'i yapar.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Gateway → auth-proxy çağrısı da mesh içinden gider: HBONE (mTLS) ile auth namespace'inin waypoint'ine.&lt;/span&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#fffdf3;strokeColor=#d8cfa3;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="20.0" y="555.0" width="1010.0" height="89.5" as="geometry"/></mxCell><mxCell id="v27" value="uygulama pod'ları · sidecar yok" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=12;fontColor=#e4e4de;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v26"><mxGeometry x="829.4" y="6.0" width="210.6" height="16.2" as="geometry"/></mxCell><mxCell id="v28" value="ns auth" style="swimlane;html=1;startSize=28;rounded=1;arcSize=4;container=1;collapsible=0;fillColor=#ffe8d4;swimlaneFillColor=#ffffff;strokeColor=#ec9656;strokeWidth=1.5;dashed=1;dashPattern=4 3;swimlaneLine=0;align=left;spacingLeft=12;fontSize=14;fontStyle=1;fontColor=#8a3d0b;fontFamily=Segoe UI;" vertex="1" parent="v26"><mxGeometry x="20.0" y="42.0" width="1010.0" height="318.0" as="geometry"/></mxCell><mxCell id="v42" value="ns edge-web" style="swimlane;html=1;startSize=28;rounded=1;arcSize=4;container=1;collapsible=0;fillColor=#ffe8d4;swimlaneFillColor=#ffffff;strokeColor=#ec9656;strokeWidth=1.5;dashed=1;dashPattern=4 3;swimlaneLine=0;align=left;spacingLeft=12;fontSize=14;fontStyle=1;fontColor=#8a3d0b;fontFamily=Segoe UI;" vertex="1" parent="v26"><mxGeometry x="20.0" y="376.0" width="1010.0" height="150.0" as="geometry"/></mxCell><mxCell id="v50" value="⬡ ztunnel · istio-cni · fluent-bit · node-exporter (soldaki node ile aynı DaemonSet'ler)" style="swimlane;html=1;startSize=26;rounded=1;arcSize=6;container=1;collapsible=0;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#6abd6a;strokeWidth=1.8;dashed=1;dashPattern=4 3;swimlaneLine=0;align=left;spacingLeft=8;fontSize=13.5;fontStyle=1;fontColor=#1f1f1f;fontFamily=Segoe UI;" vertex="1" parent="v26"><mxGeometry x="20.0" y="542.0" width="1010.0" height="34.0" as="geometry"/></mxCell><mxCell id="v52" value="&lt;span style=&quot;font-size:13.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;İstek yolu (numaralar)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;1  F5 → mobile-gw :443 (TLS, Edge-DMZ CA)    2  mobile-gw → HBONE :15008 mTLS → auth waypoint&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;3  waypoint: kaynak kimliği gateway mi?    4  waypoint → auth-proxy :8080 (ztunnel üzerinden)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;5  auth-proxy → dmz-redis (jti) · IdP (introspection + exchange) → iç JWT&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;6  karar + iç JWT mobile-gw'ye döner    7  mobile-gw → dmz-egressgw :443 → internal (04)&lt;/span&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#fffdf3;strokeColor=#d8cfa3;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="v26"><mxGeometry x="20.0" y="594.0" width="1010.0" height="108.0" as="geometry"/></mxCell><mxCell id="v53" value="1" style="ellipse;html=1;fillColor=#1d7a46;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="523.0" y="7.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v58" value="6" style="ellipse;html=1;fillColor=#1f1f1f;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="1027.0" y="237.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v6" value="◼ mobile-gw-7c9f…" style="swimlane;html=1;startSize=26;rounded=1;arcSize=6;container=1;collapsible=0;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#ec9656;strokeWidth=1.8;swimlaneLine=0;align=left;spacingLeft=8;fontSize=13.5;fontStyle=1;fontColor=#1f1f1f;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="20.0" y="38.0" width="970.0" height="241.0" as="geometry"/></mxCell><mxCell id="v10" value="⇥ in :443 ← F5 (yalnızca Edge-DMZ CA)" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#1d7a46;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11.5;fontStyle=1;fontColor=#1d7a46;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="20.0" y="292.0" width="271.3" height="19.0" as="geometry"/></mxCell><mxCell id="v11" value="↦ out → auth-proxy :8080 · ratelimit :8081 · dmz-egressgw :443" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#c2410c;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11.5;fontStyle=1;fontColor=#c2410c;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="546.2" y="292.0" width="443.8" height="19.0" as="geometry"/></mxCell><mxCell id="v14" value="DaemonSet" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v13"><mxGeometry x="173.1" y="7.5" width="62.9" height="15.5" as="geometry"/></mxCell><mxCell id="v15" value='&lt;span style="font-size:12.5px;color:#1f1f1f;font-weight:bold;"&gt;ztunnel&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;istio-system · L4 mTLS&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;in :15008 HBONE&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;çıkış yakalama :15001&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;DNS proxy :15053&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f5e8;strokeColor=#6abd6a;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v13"><mxGeometry x="8.0" y="28.0" width="228.0" height="90.0" as="geometry"/></mxCell><mxCell id="v17" value="DaemonSet" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v16"><mxGeometry x="173.1" y="7.5" width="62.9" height="15.5" as="geometry"/></mxCell><mxCell id="v18" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;istio-cni&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;pod ağına nftables kuralı&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;yazar: pod trafiği&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;ztunnel'e yönlenir&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;(pod'a yetki gerekmez)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f5e8;strokeColor=#6abd6a;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v16"><mxGeometry x="8.0" y="28.0" width="228.0" height="90.0" as="geometry"/></mxCell><mxCell id="v20" value="DaemonSet" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v19"><mxGeometry x="173.1" y="7.5" width="62.9" height="15.5" as="geometry"/></mxCell><mxCell id="v21" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;fluent-bit&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;/var/log/pods (salt okunur)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;zenginleştirme · maskeleme&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;kategori → Loki tenant'ı&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;→ mgmt (yalnızca push)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f5e8;strokeColor=#6abd6a;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v19"><mxGeometry x="8.0" y="28.0" width="228.0" height="90.0" as="geometry"/></mxCell><mxCell id="v23" value="DaemonSet" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v22"><mxGeometry x="173.1" y="7.5" width="62.9" height="15.5" as="geometry"/></mxCell><mxCell id="v24" value='&lt;span style="font-size:12.5px;color:#1f1f1f;font-weight:bold;"&gt;node-exporter&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;node metrikleri :9100&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;→ prometheus-agent&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;→ mgmt (remote_write)&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f5e8;strokeColor=#6abd6a;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v22"><mxGeometry x="8.0" y="28.0" width="228.0" height="73.0" as="geometry"/></mxCell><mxCell id="v29" value="istio.io/use-waypoint: waypoint" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=12;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" 