alue="kind-mgmt" style="rounded=0;html=1;container=1;collapsible=0;dropTarget=0;fillColor=#e5f4e5;fillOpacity=10;strokeColor=#6abd6a;strokeWidth=3;dashed=1;dashPattern=4 2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=-13;fontSize=13.5;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#6abd6a;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="920.0" y="190.0" width="1260.0" height="750.0" as="geometry"/></mxCell><mxCell id="v49" value="&lt;span style=&quot;font-size:13.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;Bu resimde&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Gözlem verisi tek yönlü: cluster'lar mgmt'e yalnızca yazar (POST), mgmt'ten okuyamaz.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Uygulama pod'ları mgmt'i görmez: log node'daki fluent-bit'ten, metrik agent'tan, iz Envoy'dan çıkar.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Çıkış her cluster'da egress gateway'in düz HTTP :80 dinleyicisi; mgmt'e :443 mTLS ile taşır.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Log ↔ iz: erişim logundaki trace_id Grafana'da Tempo'ya bağlanır.&lt;/span&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#fffdf3;strokeColor=#d8cfa3;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="970.0" width="1080.0" height="108.0" as="geometry"/></mxCell><mxCell id="v50" value="Lejant" style="rounded=1;arcSize=3;html=1;container=1;collapsible=0;fillColor=#fafaf8;strokeColor=#c4c4bf;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1140.0" y="970.0" width="1040.0" height="212.0" as="geometry"/></mxCell><mxCell id="v82" value="07 · Gözlem hattı: log (Loki), metrik (Prometheus), iz (Tempo), görüntüleme (Grafana, Kiali)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=25;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="21.0" width="1386.0" height="33.8" as="geometry"/></mxCell><mxCell id="v83" value="soldan sağa: üretici → cluster çıkışı → mgmt girişi → depo → ekran · gri kesikli: yerel toplama · mavi: zone geçişi (mTLS)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="62.0" width="1079.6" height="21.6" as="geometry"/></mxCell><mxCell id="v9" value="⬡ fluent-bit" style="swimlane;html=1;startSize=26;rounded=1;arcSize=6;container=1;collapsible=0;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#6abd6a;strokeWidth=1.8;dashed=1;dashPattern=4 3;swimlaneLine=0;align=left;spacingLeft=8;fontSize=13.5;fontStyle=1;fontColor=#1f1f1f;fontFamily=Segoe UI;" vertex="1" parent="v7"><mxGeometry x="20.0" y="30.0" width="440.0" height="146.0" as="geometry"/></mxCell><mxCell id="v12" value="⬡ edge-logs" style="swimlane;html=1;startSize=26;rounded=1;arcSize=6;container=1;collapsible=0;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#6abd6a;strokeWidth=1.8;dashed=1;dashPattern=4 3;swimlaneLine=0;align=left;spacingLeft=8;fontSize=13.5;fontStyle=1;fontColor=#1f1f1f;fontFamily=Segoe UI;" vertex="1" parent="v7"><mxGeometry x="20.0" y="250.0" width="440.0" height="95.0" as="geometry"/></mxCell><mxCell id="v15" value="◼ prometheus (agent modu)" style="swimlane;html=1;startSize=26;rounded=1;arcSize=6;container=1;collapsible=0;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#6abd6a;strokeWidth=1.8;swimlaneLine=0;align=left;spacingLeft=8;fontSize=13.5;fontStyle=1;fontColor=#1f1f1f;fontFamily=Segoe UI;" vertex="1" parent="v7"><mxGeometry x="20.0" y="380.0" width="440.0" height="112.0" as="geometry"/></mxCell><mxCell id="v18" value="◼ gateway'ler · waypoint