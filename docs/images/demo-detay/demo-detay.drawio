></mxCell><mxCell id="v51" value="4" style="ellipse;html=1;fillColor=#2f7bd8;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v25"><mxGeometry x="487.0" y="77.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v52" value="5" style="ellipse;html=1;fillColor=#c2410c;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v25"><mxGeometry x="467.0" y="211.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v53" value="6" style="ellipse;html=1;fillColor=#1f1f1f;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="997.0" y="195.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v7" value="Deployment ×1 · SA mobile-gateway" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="747.3" y="7.5" width="214.7" height="15.5" as="geometry"/></mxCell><mxCell id="v8" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;istio-proxy (Envoy) · gateway modu: Envoy pod'un kendisi&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;listener :443 · TLS (mobile-api sertifikası) · istemci sertifikası yalnızca Edge-DMZ CA (edge-waf)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;filtre 1 · header temizliği: x-user-jwt, x-partner-id silinir · x-channel=mobile yazılır&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;filtre 2 · local rate limit: 30 rps&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;filtre 3 · ext_authz → auth-service.auth:8080 (DPoP, attestation, introspection, exchange) · ret: 401 / 403 / 426&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;route · /mobile/v1/* → önek kaldırılır → dmz-egressgateway:443 · Host mobile-bff.apps.example.local · x-user-jwt&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;erişim logu (JSON: request_id, channel, trace_id, upstream_attempts) → stdout · iz → OTLP (%10)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;yönetim: :15021 sağlık · :15090 metrik · :15000 admin (yalnızca pod içi)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff1e0;strokeColor=#e39b62;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="8.0" y="28.0" width="954.0" height="141.0" as="geometry"/></mxCell><mxCell id="v9" value='&lt;span style="font-size:12.5px;color:#1f1f1f;font-weight:bold;"&gt;pilot-agent&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;xDS → istiod (dmz) :15012 (mTLS) · SPIFFE: corp.mesh/ns/istio-mobile/sa/mobile-gateway&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f5e8;strokeColor=#6abd6a;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="8.0" y="174.0" width="954.0" height="39.0" as="geometry"/></mxCell><mxCell id="v23" value="DaemonSet" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v22"><mxGeometry x="173.1" y="7.5" width="62.9" height="15.5" as="geometry"/></mxCell><mxCell id="v24" value='&lt;span style="font-size:12.5px;color:#1f1f1f;font-weight:bold;"&gt;kube-proxy · kindnet&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;Service → pod (iptables)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;pod ağı (CNI)&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f5e8;strokeColor=#6abd6a;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v22"><mxGeometry x="8.0" y="28.0" width="228.0" height="56.0" as="geometry"/></mxCell><mxCell id="v28" value="Deployment ×1" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v27"><mxGeometry x="373.8" y="7.5" width="88.2" height="15.5" as="geometry"/></mxCell><mxCell id="v29" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;istio-proxy (Envoy) · L7&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;in :15008 HBONE (yalnızca mesh kimlikleri)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;AuthZ: kaynak = token handler + 3 gateway&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;erişim logu · iz span'i (OTLP)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff1e0;strokeColor=#e39b62;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v27"><mxGeometry x="8.0" y="28.0" width="454.0" height="73.0" as="geometry"/></mxCell><mxCell id="v31" value="Deployment ×1 · SA auth-service" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v30"><mxGeometry x="289.9" y="7.5" width="202.1" height="15.5" as="geometry"/></mxCell><mxCell id="v32" value='&lt;span style="font-size:12.5px;color:#1f1f1f;font-weight:bold;"&gt;auth-service (Go, distroless, non-root)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;:8080 ext_authz kontrol ucu&lt;/span&gt;&lt;br&gt;&