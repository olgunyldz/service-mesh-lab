" width="1080.0" height="108.0" as="geometry"/></mxCell><mxCell id="v93" value="Lejant" style="rounded=1;arcSize=3;html=1;container=1;collapsible=0;fillColor=#fafaf8;strokeColor=#c4c4bf;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1140.0" y="838.0" width="1040.0" height="240.0" as="geometry"/></mxCell><mxCell id="v127" value="04 · kind-cluster-a: BFF'ler, domain servisleri, waypoint'ler, giriş ve çıkış" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=25;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="21.0" width="1161.0" height="33.8" as="geometry"/></mxCell><mxCell id="v128" value="her kutu bir namespace · satırlar pod'lar (ad · iş yükü · replika · görev) · gateway ve waypoint'ler turuncu kenarlı" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="62.0" width="1026.8" height="21.6" as="geometry"/></mxCell><mxCell id="v2" value="⇥ in ← dmz-egressgateway → VIP .201.10:443 (ISTIO_MUTUAL + Keycloak imzalı iç JWT)" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#1d7a46;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11.5;fontStyle=1;fontColor=#1d7a46;fontFamily=Segoe UI;" vertex="1" parent="v89"><mxGeometry x="26.0" y="19.0" width="581.8" height="19.0" as="geometry"/></mxCell><mxCell id="v3" value="↦ out → mgmt .203.10 (postgres, valkey, cihaz, log / metrik / iz) · httpbin.org :80" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#c2410c;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11.5;fontStyle=1;fontColor=#c2410c;fontFamily=Segoe UI;" vertex="1" parent="v89"><mxGeometry x="1557.3" y="19.0" width="588.7" height="19.0" 