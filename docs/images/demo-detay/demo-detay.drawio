f;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v37"><mxGeometry x="54.0" y="118.0" width="206.2" height="17.6" as="geometry"/></mxCell><mxCell id="v71" value="1" style="html=1;ellipse;fillColor=#1f1f1f;strokeColor=none;fontColor=#ffffff;fontSize=11;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v37"><mxGeometry x="372.0" y="117.0" width="18.0" height="18.0" as="geometry"/></mxCell><mxCell id="v72" value="adım / ayrıntı numarası" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#1f1f1f;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v37"><mxGeometry x="406.0" y="118.0" width="170.5" height="17.6" as="geometry"/></mxCell><mxCell id="v4" value="tek node" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=12;fontColor=#e4e4de;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="1391.2" y="6.0" width="58.8" height="16.2" as="geometry"/></mxCell><mxCell id="v5" value="ns account-api" style="swimlane;html=1;startSize=28;rounded=1;arcSize=4;container=1;collapsible=0;fillColor=#e4eefc;swimlaneFillColor=#ffffff;strokeColor=#6d9fe4;strokeWidth=1.5;dashed=1;dashPattern=4 3;swimlaneLine=0;align=left;spacingLeft=12;fontSize=14;fontStyle=1;fontColor=#1e4b8f;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="20.0" y="42.0" width="1420.0" height="488.0" as="geometry"/></mxCell><mxCell id="v22" value="⬡ ztunnel (DaemonSet): bu node'daki tüm pod'ların mTLS'i ve L4 yetkisi · istio-cni · fluent-bit" style="swimlane;html=1;startSize=26;rounded=1;arcSize=6;container=1;collapsible=0;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#6abd6a;strokeWidth=1.8;dashed=1;dashPattern=4 3;swimlaneLine=0;align=left;spacingLeft=8;fontSize=13.5;fontStyle=1;fontColor=#1f1f1f;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="20.0" y="546.0" width="1420.0" height="34.0" as="geometry"/></mxCell><mxCell id="v24" value='&lt;span style="font-size:13.5px;color:#1f1f1f;font-weight:bold;"&gt;İstek yolu (numaralar)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12.5px;color:#2b2b2b;"&gt;1 mobile-bff → (ztunnel → HBONE) → account-api waypoint    2 waypoint: JWT, AuthZ, rota (GET: v1/v2 ağırlıklı, retry · POST: retry yok) → pod :8080&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12.5px;color:#2b2b2b;"&gt;3 account-api → postgres (waypoint → istio-egressgateway :15432 → mgmt :5432, mTLS)&lt;/span&gt;' style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#fffdf3;strokeColor=#d8cfa3;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="20.0" y="594.0" width="1420.0" height="71.0" as="geometry"/></mxCell><mxCell id="v26" value='&lt;span style="font-size:13px;color:#1f1f1f;font-weight:bold;"&gt;İmaj&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2b2b2b;"&gt;lab-registry:5000 · cosign imzalı · digest&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2b2b2b;"&gt;Kyverno: imzasız / latest / başka registry ret&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6d9fe4;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Segoe UI;" vertex="1" parent="v25"><mxGeometry x="20.0" y="56.0" width="610.0" height="80.0" as="geometry"/></mxCell><mxCell id="v27" value='&lt;span style="font-size:13px;color:#1f1f1f;font-weight:bold;"&gt;Çalışma&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2b2b2b;"&gt;runAsNonRoot (65532) · readOnlyRootFilesystem&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2b2b2b;"&gt;seccomp RuntimeDefault · yetenek: hiçbiri&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6d9fe4;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Segoe UI;" vertex="1" parent="v25"><mxGeometry x="20.0" y="144.0" width="610.0" height="80.0" as="geometry"/></mxCell><mxCell id="v28" value='&lt;span style="font-size:13px;color:#1f1f1f;font-weight:bold;"&gt;Kaynak&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2b2b2b;"&gt;requests: 10m CPU · 16 Mi bellek&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2b2b2b;"&gt;lab: tek replika (v1 + v2)&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6d9fe4;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Segoe UI;" vertex="1" parent="v25"><mxGeometry x="20.0" y="232.0" width="610.0" height="80.0" as="geometry"/></mxCell><mxCell id="v29" value="&lt;span style=&quot;font-size:13px;color:#1f1f1f;font-weight:bold;&quot;&gt;Kimlik&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#2b2b2b;&quot;&gt;servis hesabı → SPIFFE (mesh)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#2b2b2b;&quot;&gt;AuthZ: pod'a yalnızca kendi waypoint'i&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6d9fe4;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Segoe UI;" vertex="1" parent="v25"><mxGeometry x="20.0" y="320.0" width="610.0" height="80.0" as="geometry"/></mxCell><mxCell id="v30" value='&lt;span style="font-size:13px;color:#1f1f1f;font-weight:bold;"&gt;Ağ&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2b2b2b;"&gt;dışarı yalnızca egress (ServiceEntry)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2b2b2b;"&gt;postgres: seçicisiz Service + VirtualService&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6d9fe4;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Segoe UI;" vertex="1" parent="v25"><mxGeometry x="20.0" y="408.0" width="610.0" height="80.0" as="geometry"/></mxCell><mxCell id="v31" value='&lt;span style="font-size:13px;color:#1f1f1f;font-weight:bold;"&gt;Gözlem&lt;/span&gt;&lt;br&