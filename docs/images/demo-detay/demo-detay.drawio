x="1" parent="v49"><mxGeometry x="409.3" y="118.0" width="206.2" height="17.6" as="geometry"/></mxCell><mxCell id="v85" value="1" style="html=1;ellipse;fillColor=#1f1f1f;strokeColor=none;fontColor=#ffffff;fontSize=11;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v49"><mxGeometry x="730.7" y="117.0" width="18.0" height="18.0" as="geometry"/></mxCell><mxCell id="v86" value="adım / ayrıntı numarası" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#1f1f1f;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v49"><mxGeometry x="764.7" y="118.0" width="170.5" height="17.6" as="geometry"/></mxCell><mxCell id="v5" value="Docker container · edge-net" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v4"><mxGeometry x="375.2" y="7.5" width="176.8" height="15.5" as="geometry"/></mxCell><mxCell id="v6" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;haproxy:3.0-alpine&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;:8443 TLS 1.2+/1.3 · h2 · HSTS · modern cipher'lar&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;IP başına hız (100 / 10 sn) ve bağlantı limiti&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;dışarıdan gelen X-Forwarded-*, x-user-jwt, x-channel silinir&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;partner-api: Partner CA istemci sertifikası zorunlu&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;  sertifika CN'i → x-partner-id&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;→ edge-waf:8080&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff1e0;strokeColor=#e39b62;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v4"><mxGeometry x="8.0" y="28.0" width="544.0" height="124.0" as="geometry"/></mxCell><mxCell id="v8" value="Docker container · edge-net + kind" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v7"><mxGeometry x="311.0" y="7.5" width="221.1" height="15.5" as="geometry"/></mxCell><mxCell id="v9" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;modsecurity-crs:4.25 (nginx)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;ModSecurity v3 + OWASP CRS (paranoia 1, mod On)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;403'lerde tek tip gövde&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;Host → kanal gateway VIP'i (.200.10 – .12) :443&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;DMZ'ye istemci sertifikası: Edge-DMZ CA&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;kind ağına bağlı tek internet tarafı container'ı&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff1e0;strokeColor=#e39b62;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v7"><mxGeometry x="8.0" y="28.0" width="524.0" height="124.0" as="geometry"/></mxCell><mxCell id="v11" value="Docker · edge-net" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v10"><mxGeometry x="238.5" y="7.5" width="113.5" height="15.5" as="geometry"/></mxCell><mxCell id="v12" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;curl:8.11.1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;5 sn'de bir: web girişi (PKCE)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;dashboard · echo (CSRF)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;partner acme: client credentials&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;  + istemci sertifikası&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;10 istekte bir /api/status/500&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eaf2fd;strokeColor=#6d9fe4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v10"><mxGeometry x="8.0" y="28.0" width="344.0" height="107.0" as="geometry"/></mxCell><mxCell id="v14" value="Docker · edge-net" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v13"><mxGeometry x="238.5" y="7.5" width="113.5" height="15.5" as="geometry"/></mxCell><mxCell id="v15" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;mobile-sim:0.1.1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;mobil uygulama (kullanıcı mehmet)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;PKCE + OTP (seviye 2)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;cihaz anahtarı kaydı&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;her istek: DPoP + attestation&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;5 sn'de bir hesap sorgusu&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eaf2fd;strokeColor=#6d9fe4;strokeWidth=1.2;align=l