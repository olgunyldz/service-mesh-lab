olor:#5f5f5a;&quot;&gt;  partner .200.12 · branch .200.13&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15.5px;color:#5f5f5a;&quot;&gt;edge-web/web-token-handler (cookie ↔ token)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15.5px;color:#5f5f5a;&quot;&gt;auth/auth-service (ext_authz, exchange)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15.5px;color:#5f5f5a;&quot;&gt;ratelimit/ratelimit (partner kotası)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15.5px;color:#5f5f5a;&quot;&gt;istio-egress/dmz-egressgateway (tek çıkış)&lt;/span&gt;" style="rounded=1;arcSize=3;html=1;container=1;collapsible=0;dropTarget=0;whiteSpace=wrap;fillColor=#ffe8d4;strokeColor=#ec9656;strokeWidth=1.8;dashed=1;dashPattern=4 3;verticalAlign=top;align=left;spacingLeft=24;spacingTop=12;spacingRight=12;fontFamily=Segoe UI;" vertex="1" parent="v13"><mxGeometry x="610.0" y="40.0" width="570.0" height="320.0" as="geometry"/></mxCell><mxCell id="v16" value='&lt;span style="font-size:19px;color:#1f5f1f;"&gt;kind-mgmt · kimlik, veri, gözlem&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:15.5px;color:#5f5f5a;"&gt;1 node · istiod · ambient&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:15.5px;color:#5f5f5a;"&gt;istio-ingressgateway VIP .203.10 (SNI ile)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:15.5px;color:#5f5f5a;"&gt;iam: keycloak 26.8 · device-registry&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:15.5px;color:#5f5f5a;"&gt;data: postgres 18 · valkey 9&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:15.5px;color:#5f5f5a;"&gt;logging: loki 3.7 · tempo 2.10&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:15.5px;color:#5f5f5a;"&gt;istio-system: prometheus · grafana · kiali&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:15.5px;color:#5f5f5a;"&gt;giriş yalnızca egress gateway kimlikleriyle&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:15.5px;color:#5f5f5a;"&gt;internete kapalı&lt;/span&gt;' style="rounded=1;arcSize=3;html=1;container=1;collapsible=0;dropTarget=0;