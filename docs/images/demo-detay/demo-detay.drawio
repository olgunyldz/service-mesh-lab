;fontColor=#1f1f1f;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="20.0" y="38.0" width="600.0" height="231.0" as="geometry"/></mxCell><mxCell id="v10" value="⇥ in ← channel-bff BFF'leri · istio-ingressgateway (HBONE)" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#1d7a46;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11.5;fontStyle=1;fontColor=#1d7a46;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="20.0" y="278.0" width="416.2" height="19.0" as="geometry"/></mxCell><mxCell id="v11" value="◼ account-api-…  (version: v1)" style="swimlane;html=1;startSize=26;rounded=1;arcSize=6;container=1;collapsible=0;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#6d9fe4;strokeWidth=1.8;swimlaneLine=0;align=left;spacingLeft=8;fontSize=13.5;fontStyle=1;fontColor=#1f1f1f;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="660.0" y="38.0" width="740.0" height="217.0" as="geometry"/></mxCell><mxCell id="v16" value="◼ account-api-v2-…  (version: v2)" style="swimlane;html=1;startSize=26;rounded=1;arcSize=6;container=1;collapsible=0;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#6d9fe4;strokeWidth=1.8;swimlaneLine=0;align=left;spacingLeft=8;fontSize=13.5;fontStyle=1;fontColor=#1f1f1f;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="660.0" y="269.0" width="740.0" height="78.0" as="geometry"/></mxCell><mxCell id="v19" value="⇥ in ← waypoint (HBONE :15008 → :8080)" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#1d7a46;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11.5;fontStyle=1;fontColor=#1d7a46;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="660.0" y="360.0" width="278.2" height="19.0" as="geometry"/></mxCell><mxCell id="v20" value="↦ out → postgres.account-api:5432 → waypoint → egress :15432 → mgmt" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#c2410c;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11.5;fontStyle=1;fontColor=#c2410c;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="660.0" y="386.0" width="478.3" height="19.0" as="geometry"/></mxCell><mxCell id="v21" value="↦ out → log (stdout → fluent-bit) · iz (traceparent taşınır)" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#c2410c;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11.5;fontStyle=1;fontColor=#c2410c;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="660.0" y="412.0" width="430.0" height="19.0" as="geometry"/></mxCell><mxCell id="v23" value="DaemonSet" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v22"><mxGeometry x="1349.1" y="7.5" width="62.9" height="15.5" as="geometry"/></mxCell><mxCell id="v34" value="2" style="ellipse;html=1;fillColor=#2f7bd8;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="627.0" y="97.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v35" value="3" style="ellipse;html=1;fillColor=#c2410c;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="633.0" y="386.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v8" value="Deployment ×1 · L7" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v7"><mxGeometry x="472.1" y="7.5" width="119.9" height="15.5" as="geometry"/></mxCell><mxCell id="v9" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;istio-proxy (Envoy)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;in :15008 HBONE · yalnızca mesh kimlikleri&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;RequestAuthentication: iç JWT (customers / partners /&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;  staff realm'i, aud internal-apis, Keycloak JWKS)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;AuthZ: web-bff, mobile-bff, branch-bff, ingress (partner)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;VirtualService read (GET): v1 %90 · v2 %10&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;  timeout 3 sn · 2 yeniden deneme (1 sn / deneme)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;VirtualService write (POST): timeout 5 sn · retry YOK&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;DestinationRule: en çok 50 bağlantı · 20 bekleyen&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;  outlier: 5 ardışık 5xx → 15 sn havuz dışı&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;erişim logu (upstream_attempts) · metrik (proxyStatsMatcher)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff1e0;strokeColor=#e39b62;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v7"><mxGeometry x="8.0" y="28.0" width="584.0" height="192.0" as="geometry"/></mxCell><mxCell id="v12" value="Deployment ×1 · SA account-api" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v11"><mxGeometry x="536.2" y="7.5" width="195.8" height="15.5" as="geometry"/></mxCell><mxCell id="v13" value='&lt;span style="font-size:12.5px;color:#1f1f1f;font-weight:bold;"&gt;api (Go, distroless, non-root 65532)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;:8080 HTTP · /accounts · /accounts/{id}/transfers · onaylar&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;RELEASE=v1 · BOLA (sahiplik) · seviye 2 (son 5 dk) · onay limiti 10.000&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;personel: yalnızca kendi şubesi · dört göz (CHECK)&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eaf2fd;strokeColor=#6d9fe4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v11"><mxGeometry x="8.0" y="28.0" width="724.0" height="73.0" as="geometry"/></mxCell><mxCell id="v14" value='&lt;span style="font-size:12.5px;color:#1f1f1f;font-weight:bold;"&gt;secret · env&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;PGHOST postgres.account-api (seçicisiz Service → egress)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;DB parolası: Kubernetes Secret (05b), servis başına rol&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f3ecfb;strokeColor=#a383e0;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v11"><mxGeometry x="8.0" y="106.0" width="724.0" height="56.0" as="geometry"/></mxCell><mxCell id="v15" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;kimlik&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;SPIFFE: corp.mesh/ns/account-api/sa/account-api · sertifika ztunnel'de&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f2f2f2;strokeColor=#a3a3a3;strokeWidth=1.2;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v11"><mxGeometry x="8.0" y="167.0" width="724.0" height="39.0" as="geometry"/></mxCell><m