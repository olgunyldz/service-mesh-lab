# Ortam genel ayarları - tüm scriptler bu dosyayı source eder.

# 1.31.x GA chart'ları helm reposunda yayınlanmamış (base-1.31.3.tgz -> 404); helm'deki en güncel kararlı sürüm.
# istioctl 1.31.x bu kontrol düzlemiyle çalışır (n-1 desteği).
ISTIO_VERSION=1.30.7
K8S_NODE_IMAGE=kindest/node:v1.36.4
GATEWAY_API_VERSION=v1.6.0   # Istio 1.30 v1.5.1 ile test edilir; v1 API geriye uyumlu
METALLB_VERSION=v0.16.1
KIALI_VERSION=2.26.0        # Istio 1.30 samples/addons/kiali.yaml ile aynı

# Edge (dış DMZ): Kubernetes dışında Docker container'ları
HAPROXY_IMAGE=haproxy:3.0-alpine
WAF_IMAGE=owasp/modsecurity-crs:4.25.2-nginx-alpine-202610180210-lts   # ModSecurity v3 + CRS 4 LTS
WAF_MODE=On                 # On (engelle) | DetectionOnly (yalnızca logla). Gerçekte önce DetectionOnly
LOADGEN_IMAGE=curlimages/curl:8.11.1
EDGE_NETWORK=edge-net       # internet tarafı: edge-lb + edge-waf + loadgen; cluster'lara erişemez

MESH_ID=corp-mesh
TRUST_DOMAIN=corp.mesh
APPS_DOMAIN=apps.example.local

# Aktif cluster'lar (mgmt: paylaşılan ürünler, 04. adım). cluster-b RAM kısıtı nedeniyle şimdilik kapalı; yol haritasının son adımında
# listeye eklenerek geri gelir. Eklenince manifests/*/cluster-b/ klasörleri de otomatik uygulanır.
CLUSTERS="dmz cluster-a mgmt"

# Registry önbelleği (pull-through cache): <registry>=<asıl adres>
REGISTRY_IMAGE=registry:2.8.3
# registry.istio.io bilerek yok: registry:2 proxy'si onunla çalışmıyor; Istio docker.io/istio'dan çekiliyor
REGISTRY_MIRRORS="docker.io=https://registry-1.docker.io quay.io=https://quay.io ghcr.io=https://ghcr.io"

# Politika (05 · policy): Kyverno admission controller + imzalı image zorunluluğu
KYVERNO_CHART_VERSION=3.9.2   # Kyverno v1.19.2
POLICY_ACTION=Deny            # Deny (reddet) | Audit (yalnızca raporla). Gerçekte önce Audit, raporlar temizlenince Deny
COSIGN_IMAGE=ghcr.io/sigstore/cosign/cosign:v2.5.3
# Kurumsal iç registry'nin (Harbor/Quay/Nexus) karşılığı. Uygulama image'ları buraya kopyalanıp cosign ile imzalanır.
# Önbellekler gibi kalıcıdır; 99-destroy.sh --cache siler.
LAB_REGISTRY=lab-registry:5000
# Lab registry'ye kopyalanıp imzalanan image'lar: <kaynak>=<lab registry'deki adı>
LAB_IMAGES="ghcr.io/stefanprodan/podinfo:6.7.1=lab/podinfo:6.7.1 docker.io/curlimages/curl:8.11.1=lab/curl:8.11.1
  docker.io/library/postgres:18.1-alpine=lab/postgres:18.1-alpine docker.io/valkey/valkey:9.0.0-alpine=lab/valkey:9.0.0-alpine
  docker.io/envoyproxy/ratelimit:f4e76690=lab/ratelimit:f4e76690"
# Negatif test için imzalanmadan kopyalanan image
LAB_UNSIGNED_IMAGE=lab/curl-unsigned:8.11.1
# Lab registry'ye host'tan image itmek için (yalnızca 127.0.0.1; Go servislerinin build'i)
LAB_REGISTRY_HOST_PORT=5001
# Kendi servislerimiz (services/<ad>/): build -> lab registry -> cosign imzası. <ad>:<sürüm>
LAB_BUILDS="web-bff:0.1.0 account-api:0.1.0"
GO_BUILD_IMAGE=golang:1.27.1-alpine
GO_RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot

# DMZ kanalları (06 · dmz-channels): her kanalın kendi host'u, gateway'i ve MetalLB VIP'i (dmz /24'ünde son oktet)
#   web     -> www.<APPS_DOMAIN>         -> dmz-ingressgateway -> web-bff
#   mobile  -> mobile-api.<APPS_DOMAIN>  -> mobile-gateway
#   partner -> partner-api.<APPS_DOMAIN> -> partner-gateway (edge'de partner istemci sertifikası zorunlu)
#   branch  -> branch-api.corp.internal -> branch-gateway (internet edge'i yok: şube WAN'ı -> iç firewall; cihaz sertifikası)
WEB_HOST=www.apps.example.local
MOBILE_HOST=mobile-api.apps.example.local
PARTNER_HOST=partner-api.apps.example.local
BRANCH_HOST=branch-api.corp.internal
BRANCH_NETWORK=branch-net     # şube WAN'ı: branch-terminal + branch-fw; internetten (edge-net) ayrı
BRANCH_DEVICE=sube-0001       # örnek şube terminalinin cihaz sertifikası
channel_vip_octet() {
  case "$1" in
    web) echo 10 ;;
    mobile) echo 11 ;;
    partner) echo 12 ;;
    branch) echo 13 ;;
  esac
}

# Veri (07 · data): tüm veri mgmt'te. Diğer cluster'lar egress gateway'leri üzerinden, mTLS ile erişir.
#   <istemci> -> waypoint -> egress gw :1<port> --mTLS--> mgmt ingress gw :<port> --> ns data
POSTGRES_HOST=postgres.mgmt.internal   # mesh içi ad (mgmt ingress gateway SNI)
VALKEY_HOST=valkey.mgmt.internal
POSTGRES_DB=corebank

# MetalLB IP havuzu için kind docker ağının ilk iki okteti (02-install-metallb.sh otomatik tespit eder,
# boş bırakılırsa). Her cluster'a ayrı bir /24 verilir: dmz=.200, cluster-a=.201, cluster-b=.202
NET_PREFIX=

# Cluster adı -> üçüncü oktet
lb_octet() {
  case "$1" in
    dmz) echo 200 ;;
    cluster-a) echo 201 ;;
    cluster-b) echo 202 ;;
    mgmt) echo 203 ;;
  esac
}

# Tek Kiali ve tek Grafana mgmt cluster'ında (kind extraPortMappings ile aynı olmalı)
KIALI_PORT=20001
GRAFANA_PORT=3001
# Merkezi Prometheus'un mesh içi adı: egress gateway'ler bu host'u mgmt'e yönlendirir
METRICS_HOST=prometheus.mgmt.internal

# Cluster adı -> Istio network adı
network_of() { echo "net-$1"; }

# kind context adı
ctx() { echo "kind-$1"; }
