# Ortam genel ayarları - tüm scriptler bu dosyayı source eder.

# 1.31.x GA chart'ları helm reposunda yayınlanmamış (base-1.31.3.tgz -> 404); helm'deki en güncel kararlı sürüm.
# istioctl 1.31.x bu kontrol düzlemiyle çalışır (n-1 desteği).
ISTIO_VERSION=1.30.7
K8S_NODE_IMAGE=kindest/node:v1.36.4
GATEWAY_API_VERSION=v1.6.0   # Istio 1.30 v1.5.1 ile test edilir; v1 API geriye uyumlu
METALLB_VERSION=v0.16.1

MESH_ID=corp-mesh
TRUST_DOMAIN=corp.mesh
APPS_DOMAIN=apps.example.local

CLUSTERS="dmz cluster-a cluster-b"

# MetalLB IP havuzu için kind docker ağının ilk iki okteti (02-install-metallb.sh otomatik tespit eder,
# boş bırakılırsa). Her cluster'a ayrı bir /24 verilir: dmz=.200, cluster-a=.201, cluster-b=.202
NET_PREFIX=

# Cluster adı -> üçüncü oktet
lb_octet() {
  case "$1" in
    dmz) echo 200 ;;
    cluster-a) echo 201 ;;
    cluster-b) echo 202 ;;
  esac
}

# Cluster adı -> Istio network adı
network_of() { echo "net-$1"; }

# kind context adı
ctx() { echo "kind-$1"; }
